@using Microsoft.AspNetCore.Components.Authorization
@using Microsoft.AspNetCore.Components.Routing
@using Microsoft.AspNetCore.Http
@using Scalemon.WebApp.Components.Auth


<!DOCTYPE html>
<html lang="ru">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
 

    <!-- Ваши стили -->
    
    
    <link rel="icon" type="image/png" href="_content/Scalemon.WebApp/favicon.png" />

    <!-- ЕДИНСТВЕННЫЙ «загрузчик» темы -->
    <RadzenTheme Theme="material" @rendermode="InteractiveServer" />
    <link rel="stylesheet" href="_content/Scalemon.WebApp/app.css" />
    <HeadOutlet />
</head>

<body>
    <CascadingAuthenticationState>
        <Routes @rendermode="InteractiveServer">
            <Found Context="routeData">
                <AuthorizeRouteView RouteData="@routeData" DefaultLayout="typeof(Layout.MainLayout)">
                    <NotAuthorized>
                        <RedirectToLogin />
                    </NotAuthorized>
                </AuthorizeRouteView>
                <FocusOnNavigate RouteData="@routeData" Selector="h1" />
            </Found>
            <NotFound>
                <LayoutView Layout="typeof(Layout.MainLayout)">
                    <div class="rz-p-4">
                        <h3>Страница не найдена</h3>
                        <a href="/">На главную</a>
                    </div>
                </LayoutView>
            </NotFound>
        </Routes>
    </CascadingAuthenticationState>

    <script src="_content/Scalemon.WebApp/auth.js"></script>
    <script src="_content/Scalemon.WebApp/app.js?v=@(typeof(App).Assembly.GetName().Version)"></script>
    <script src="_framework/blazor.web.js"></script>
    <script src="_content/Radzen.Blazor/Radzen.Blazor.js"></script>
</body>

@code {
        [CascadingParameter]
            private HttpContext HttpContext { get; set; } = default!;

        [Inject]
        private ThemeService ThemeService { get; set; } = default!;

        protected override void OnInitialized()
        {
                base.OnInitialized();

                if (HttpContext != null)
                {
                        var theme = HttpContext.Request.Cookies["MyApplicationTheme"];

                        if (!string.IsNullOrEmpty(theme))
                        {
                                ThemeService.SetTheme(theme, false);
                        }
                }
        }
}
</html>
