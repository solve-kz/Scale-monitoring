@page "/login"
@attribute [AllowAnonymous]
@using System.Linq
@using Microsoft.AspNetCore.Authorization
@using Microsoft.AspNetCore.WebUtilities
@using Radzen
@using Scalemon.WebApp.Models
@inject NavigationManager Nav
@inject NotificationService NotificationService
@inject IJSRuntime JS
@inject ISettingsSource SettingsSource

<RadzenStack Orientation="Orientation.Vertical"
             JustifyContent="JustifyContent.Center"
             AlignItems="AlignItems.Center"
             Gap="1.5rem"
             Style="min-height:100vh;background-color:var(--rz-base-200);padding:2rem;">
    <RadzenCard Class="rz-shadow-3 rz-w-100" Style="max-width:900px;padding:0;">
        <RadzenRow>
            <RadzenColumn Size="12" SizeMD="5" Style="display:flex;align-items:center;justify-content:center;padding:2.5rem;background-color:var(--rz-base-50);border-bottom:1px solid var(--rz-base-200);">
                <RadzenImage Path="_content/Scalemon.WebApp/images/logo.png"
                             Style="max-width:220px;width:100%;height:auto;"
                             AlternateText="ScaleMonitoring" />
            </RadzenColumn>
            <RadzenColumn Size="12" SizeMD="7" Style="padding:2.5rem;display:flex;flex-direction:column;gap:1.5rem;">
                <RadzenHeading Size="HeadingSize.H4" Text="Добро пожаловать" />
                <RadzenText Class="rz-text-secondary">Введите учетные данные, чтобы продолжить работу.</RadzenText>
                <RadzenTemplateForm TItem="LoginModel" Data="@_model" Submit="OnSubmitAsync">
                    <RadzenFieldset Style="border:none;padding:0;margin:0;">
                        <RadzenStack Orientation="Orientation.Vertical" Gap="12">
                            <RadzenStack Orientation="Orientation.Vertical" Gap="0.5rem">
                                <RadzenLabel Text="Имя пользователя" Component="Username" />
                                <RadzenTextBox @bind-Value="_model.Username"
                                               Name="Username"
                                               Style="width:100%"
                                               Placeholder="Введите имя пользователя" />
                                <RadzenRequiredValidator Component="Username" Text="Укажите имя пользователя" Popup="false" />
                            </RadzenStack>
                            <RadzenStack Orientation="Orientation.Vertical" Gap="0.5rem">
                                <RadzenLabel Text="Пароль" Component="Password" />
                                <RadzenPassword @bind-Value="_model.Password"
                                                Name="Password"
                                                Style="width:100%"
                                                Placeholder="Введите пароль" />
                                <RadzenRequiredValidator Component="Password" Text="Укажите пароль" Popup="false" />
                            </RadzenStack>
                            <RadzenStack Orientation="Orientation.Horizontal"
                                         JustifyContent="JustifyContent.Center">
                                <RadzenButton Text="Войти"
                                              Icon="login"
                                              ButtonStyle="ButtonStyle.Primary"
                                              Size="ButtonSize.Medium"
                                              ButtonType="ButtonType.Submit"
                                              IsBusy="@_busy"
                                              Disabled="@_busy"
                                              Style="width:60%" />
                            </RadzenStack>
                        </RadzenStack>
                    </RadzenFieldset>
                </RadzenTemplateForm>
            </RadzenColumn>
        </RadzenRow>
    </RadzenCard>
</RadzenStack>



@code {
    private readonly LoginModel _model = new();
    private bool _busy;
    private SettingsDto? _cachedSettings;

    private async Task OnSubmitAsync(LoginModel model)
    {
        if (_busy)
        {
            return;
        }

        _busy = true;
        try
        {
            var ok = await JS.InvokeAsync<bool>("scalemon.login", model.Username, model.Password);
            if (ok)
            {
                var target = await ResolveTargetUrlAsync();
                Nav.NavigateTo(target, forceLoad: true);
                return;
            }

            NotificationService.Notify(NotificationSeverity.Error, "Ошибка входа", "Неверный логин или пароль");
        }
        catch (Exception ex)
        {
            NotificationService.Notify(NotificationSeverity.Error, "Ошибка входа", ex.Message);
        }
        finally
        {
            _busy = false;
        }
    }

    private async Task<string> ResolveTargetUrlAsync()
    {
        var uri = Nav.ToAbsoluteUri(Nav.Uri);
        var query = QueryHelpers.ParseQuery(uri.Query);
        if (query.TryGetValue("returnUrl", out var values))
        {
            var returnUrl = values.FirstOrDefault();
            if (!string.IsNullOrWhiteSpace(returnUrl))
            {
                return returnUrl!;
            }
        }

        _cachedSettings ??= await SettingsSource.LoadAsync();
        var fallback = _cachedSettings.WebUiSettings?.AfterLoginPage;
        return string.IsNullOrWhiteSpace(fallback) ? "/" : fallback!;
    }

    private sealed class LoginModel
    {
        public string? Username { get; set; }
        public string? Password { get; set; }
    }
}
