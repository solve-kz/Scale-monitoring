@page "/monitoring"
@using System.Globalization
@using Microsoft.AspNetCore.Authorization
@using Scalemon.WebApp.Models
@using Scalemon.WebApp.Data
@using static Scalemon.WebApp.Models.WeighingModels
@using Microsoft.AspNetCore.WebUtilities
@using Microsoft.AspNetCore.Components.Server.ProtectedBrowserStorage
@inject ProtectedLocalStorage PLS
@attribute [Authorize(Policy = "CanViewMonitoring")]
@inject IWeighingDataService Data
@inject NavigationManager Nav
@inject SecurityService Security

<RadzenRow>   

    <!-- ЛЕВАЯ КОЛОНКА: заголовок + таблица -->
    <RadzenColumn Size="12" SizeLG="9">
        <!-- Новый заголовок с «сводкой» + переключатель режима -->
        <RadzenCard Style="padding:0">
            <RadzenStack Orientation="Orientation.Horizontal"
                         JustifyContent="JustifyContent.SpaceBetween"
                         AlignItems="AlignItems.Center"
                         class="rz-p-3 rz-pb-2">

                <RadzenStack Orientation="Orientation.Vertical" class="rz-w-75 rz-pl-4">
					<RadzenText TextStyle="TextStyle.H5" TextAlign="TextAlign.Left">
						@(
												_totalCount > 0
												? $"Реестр взвешиваний за {SelectedDate:dd.MM.yyyy}"
												: "Данные за день отсутствуют"
												)
					</RadzenText>
                    <RadzenStack Orientation="Orientation.Horizontal" JustifyContent="JustifyContent.Left">

						<RadzenText TextStyle="TextStyle.Subtitle2">
							@{
								var ru = CultureInfo.GetCultureInfo("ru-RU");
								var sumText = _daySummary?.Sum.ToString("N2", ru) ?? "0,00";
								var cntText = (_daySummary?.Count ?? 0).ToString("N0", ru);
							}
							Всего: <b>@sumText</b> кг (<b>@cntText</b> шт.)
						</RadzenText>
						<RadzenText TextStyle="TextStyle.Subtitle2">
							@{
								var ru = CultureInfo.GetCultureInfo("ru-RU");
								var avgText = _daySummary?.Avg?.ToString("N2", ru) ?? "0,00";
								var minText = _daySummary?.Min?.ToString("N2", ru) ?? "—";
								var maxText = _daySummary?.Max?.ToString("N2", ru) ?? "—";
							}
							Средний вес <b>@avgText</b> кг (min: <b>@minText</b> кг, max: <b>@maxText</b> кг)
						</RadzenText>
					</RadzenStack>
                </RadzenStack>
                
                

                <RadzenStack Orientation="Orientation.Horizontal" AlignItems="AlignItems.Center" Gap="0.5rem">
                    <RadzenText TextStyle="TextStyle.Subtitle2">@(_isDetailed ? "Подробный" : "Сводный")</RadzenText>
                    <RadzenSwitch @bind-Value="_isDetailed" @bind-Value:after="OnUiChanged" />
                </RadzenStack>
            </RadzenStack>
        </RadzenCard>

        <WeightsGrid @ref="_grid"
                     IsDetailed="@_isDetailed"
                     Rows="@_rows"
                     Totals="@_totals"
                     TotalCount="@_totalCount"
                     PageSize="400"
                     PageChanged="@OnPageChanged"
                     CellSelected="@OnCellSelected"
                     ActionRequested="@OnActionFromGrid"
                     CanEdit="@_canEdit" />
    </RadzenColumn>

    <!-- ПРАВАЯ КОЛОНКА: календарь + детали -->
    <RadzenColumn Size="12" SizeLG="3"
                  Style="display:flex; flex-direction:column; min-height:100vh;">
        <!-- Нижний блок, "прилипший" к низу окна -->
        <div style="margin-top:auto; position:sticky; bottom:0px; z-index:10; width:100%;">
            <RadzenStack Orientation="Orientation.Vertical"
                         AlignItems="AlignItems.Center"
                         Gap="0.75rem"
                         Style="width:100%; max-height:calc(100vh - 24px); overflow:auto;">
                @if (_showDetails && _selectedCell?.HasValue == true)
                {
                    <RecordDetailsPanel Cell="@_selectedCell"
                                        OrderInDay="@_selectedOrderInDay"
                                        Visible="@_showDetails"
                                        ActionRequested="@OnActionFromDetails"
                                        CanEdit="@_canEdit" />
                }
                <div style="min-height:calc(100vh - 700px);">

                </div>

                <CalendarWithMarks SelectedDate="@SelectedDate"
                                   SelectedDateChanged="@OnDatePicked"
                                   MarkedDays="@_markedDays"
                                   MonthChanged="@OnMonthChanged" />
            </RadzenStack>
        </div>
    </RadzenColumn>

</RadzenRow>

@code {

    WeightsGrid? _grid;

    const decimal Step = 0.02m;

    DateTime SelectedDate = DateTime.Today;
    int _pageIndex = 0;

    HashSet<DateOnly> _markedDays = new();
    DaySummary? _daySummary;

    bool _isDetailed = true;
    bool _canEdit;

    IReadOnlyList<GridRowVm> _rows = Array.Empty<GridRowVm>();
    decimal[] _totals = new decimal[10];
    int _totalCount = 0;

    Cell? _selectedCell;
    int? _selectedOrderInDay; // <— номер взвешивания за день для панели «детали»
    bool _showDetails => _isDetailed && _selectedCell?.HasValue == true;

    const string UiStateKey = "scalemon.monitoring.ui.v2";
    const string ReturnKey = "scalemon.nav.return.v1"; // «билет» назад из Logs
    bool _uiLoaded; // начинаем сохранять только после первого рендера

    sealed class MonitoringUiStateV2
    {
        public bool? IsDetailed { get; set; }
    }

    sealed class ReturnToMonitoring
    {
        public string From { get; set; } = "monitoring";
        public DateTime Date { get; set; }               // выбранная дата
        public int PageIndex { get; set; }               // страница (0..)
        public int? SelectedOrderInDay { get; set; }     // № взвешивания за день (1..N), может быть null
        public DateTime CreatedAt { get; set; } = DateTime.Now;
    }

    protected override async Task OnInitializedAsync()
    {
        await DeterminePermissionsAsync();
        await LoadMonthMarks(SelectedDate.Year, SelectedDate.Month);
        await LoadPage(0);
    }

    async Task DeterminePermissionsAsync()
    {
        await Security.InitializeAsync();
        _canEdit = Security.IsInAnyRole("Editor", "Admin");
    }

    async Task OnMonthChanged((int Year, int Month) arg)
    {
        _selectedCell = null;
        await _grid!.ClearSelectionAsync();                
        await LoadMonthMarks(arg.Year, arg.Month);
        
    }


    async Task OnDatePicked(DateTime date)
    {
        await _grid!.ClearSelectionAsync();   // сброс подсветки
        SelectedDate = date.Date;
        _pageIndex = 0;
        _selectedCell = null;
        await LoadPage(0);

        if (_grid != null)
            await _grid.GoFirstPageAsync(); // сброс RadzenPager
    }

    async Task OnPageChanged(int pageIndex)
    {
        _pageIndex = pageIndex;
        _selectedCell = null;
        await _grid!.ClearSelectionAsync();
        await LoadPage(pageIndex);
        await SaveUiStateAsync();
    }

    async Task LoadMonthMarks(int year, int month)
    {
        var dict = await Data.GetMonthStatsAsync(year, month);
        _markedDays = dict.Keys.ToHashSet();
        StateHasChanged();
    }

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (!firstRender) return;

        // Всегда читаем только режим из UI-состояния
        await LoadUiStateAsync();

        // По умолчанию — сегодня
        SelectedDate = DateTime.Today;

        // Если пришли с ?restore=1 и есть билет — восстановимся
        var uri = Nav.ToAbsoluteUri(Nav.Uri);
        var query = QueryHelpers.ParseQuery(uri.Query);
        if (query.TryGetValue("restore", out var v) && v == "1")
        {
            var res = await PLS.GetAsync<ReturnToMonitoring>(ReturnKey);
            var t = res.Success ? res.Value : null;

            if (t != null && t.From == "monitoring")
            {
                SelectedDate = t.Date.Date;
                _pageIndex = Math.Max(0, t.PageIndex);

                await LoadMonthMarks(SelectedDate.Year, SelectedDate.Month);
                await LoadPage(_pageIndex);
                if (_grid != null)
                {
                    await _grid.GoToPageAsync(_pageIndex); // программно перейти на страницу
                    if (t.SelectedOrderInDay is int orderInDay && orderInDay > 0)
                    {
                        int orderOnPage = ((orderInDay - 1) % 400) + 1; // 1..400
                        await _grid.SetSelectionByOrderOnPageAsync(orderOnPage);
                        _selectedOrderInDay = orderInDay;
                        _selectedCell = TryGetCellByOrderOnPage(orderOnPage);
                    }
                }

                // Билет израсходован — удаляем
                await PLS.DeleteAsync(ReturnKey);
                StateHasChanged();
                _uiLoaded = true;
                return;
            }
        }

        // Обычный запуск — «сегодня» + первая страница
        await LoadMonthMarks(SelectedDate.Year, SelectedDate.Month);
        await LoadPage(0);
        if (_grid != null) await _grid.GoFirstPageAsync();

        _uiLoaded = true;
        StateHasChanged();
    }

    static Cell? GetCellFromRow(WeighingModels.GridRow row, int col) => col switch
    {
        1 => row.C1,
        2 => row.C2,
        3 => row.C3,
        4 => row.C4,
        5 => row.C5,
        6 => row.C6,
        7 => row.C7,
        8 => row.C8,
        9 => row.C9,
        10 => row.C10,
        _ => null
    };

    Cell? TryGetCellByOrderOnPage(int orderOnPage)
    {
        int idx = Math.Clamp(orderOnPage, 1, 400) - 1;
        int col = (idx / 40) + 1;
        int rowIdx = idx % 40; // 0..39
        var vm = _rows.ElementAtOrDefault(rowIdx);
        return vm is null ? null : GetCellFromRow(vm.Row, col);
    }



    async Task LoadUiStateAsync()
    {
        try
        {
            var res = await PLS.GetAsync<MonitoringUiStateV2>(UiStateKey);
            var s = res.Success ? res.Value : null;
            if (s is null) return;
            if (s?.IsDetailed is bool det && det != _isDetailed)
            {
                _isDetailed = det;
            }
        }
        catch { /* ok */ }
    }

    async Task SaveUiStateAsync()
    {
        if (!_uiLoaded) return;
        await PLS.SetAsync(UiStateKey, new MonitoringUiStateV2 { IsDetailed = _isDetailed });
    }


    async Task LoadPage(int pageIndex)
    {
        var dateOnly = DateOnly.FromDateTime(SelectedDate);

        // теперь сюда передаём pageIndex и PageSize
        var (items, total) = await Data.GetDayPageAsync(dateOnly, pageIndex, 400);
        _totalCount = total;

        // Получаем ВСЕ записи за день (только для сводки)
        var allItems = await Data.GetDayAllAsync(dateOnly);
        var weights = allItems.Select(x => x.Weight).ToList();

        _daySummary = new DaySummary(
            Count: weights.Count,
            Sum: weights.Sum(),
            Min: weights.Count > 0 ? weights.Min() : null,
            Max: weights.Count > 0 ? weights.Max() : null,
            Avg: weights.Count > 0 ? weights.Average() : null);

        // Построение матрицы — только для текущей страницы
        BuildMatrix(items);
    }

    void BuildMatrix(IReadOnlyList<Weighing> items)
    {
        var ordered = items.OrderBy(x => x.Timestamp).ToList();

        // 10 столбцов по 40 ячеек
        var columns = new List<List<Cell>>(10);
        for (int i = 0; i < 10; i++)
            columns.Add(new List<Cell>(40));

        // раскладываем данные: сначала 40 строк первого столбца, потом второго и т.д.
        for (int i = 0; i < ordered.Count && i < 400; i++)
        {
            int col = i / 40;   // номер столбца (0..9)
            int row = i % 40;   // номер строки в столбце (0..39)

            columns[col].Add(new Cell(ordered[i].Id, ordered[i].Weight, ordered[i].Timestamp));
        }

        // дополняем пустыми ячейками до 40 в каждом столбце
        for (int col = 0; col < 10; col++)
            while (columns[col].Count < 40)
                columns[col].Add(new Cell(null, null, null));

        // собираем строки для грида
        var rows = new List<GridRowVm>(40);
        for (int r = 0; r < 40; r++)
        {
            var data = new GridRow(
                columns[0][r], columns[1][r], columns[2][r], columns[3][r], columns[4][r],
                columns[5][r], columns[6][r], columns[7][r], columns[8][r], columns[9][r]);

            rows.Add(new GridRowVm(r + 1, data));
        }
        _rows = rows;

        // итоги по столбцам
        for (int col = 0; col < 10; col++)
            _totals[col] = columns[col].Where(c => c.HasValue).Sum(c => c!.Weight!.Value);
    }

    Task OnCellSelected(Cell? cell)
    {
        _selectedCell = cell;
        // считаем «№ взвешивания за день»: (текущая страница * 400) + позиция на странице
        var posOnPage = _grid?.GetSelectedOrderOnPage(); // 1..400
        _selectedOrderInDay = (posOnPage.HasValue ? (_pageIndex * 400) + posOnPage.Value : null);

        return Task.CompletedTask;
    }

    async Task OnUiChanged() => await SaveUiStateAsync();

    
    async Task SaveReturnTicketAsync()
    {
        // пытаемся вычислить точный № за день
        var posOnPage = _grid?.GetSelectedOrderOnPage(); // 1..400 или null
        int? orderInDay = posOnPage.HasValue ? (_pageIndex * 400) + posOnPage.Value : _selectedOrderInDay;

        var ticket = new ReturnToMonitoring
        {
            Date = SelectedDate.Date,
            PageIndex = _pageIndex,
            SelectedOrderInDay = orderInDay
        };
        await PLS.SetAsync(ReturnKey, ticket);
    }
    
    async Task OnActionFromGrid(string action)
    {
        if (!_canEdit)
            return;
        if (_selectedCell?.HasValue != true) return;
        var id = _selectedCell.Id!.Value;

        switch (action)
        {
            case "inc":      await Data.AdjustAsync(id, +Step); break;
            case "dec":      await Data.AdjustAsync(id, -Step); break;
            case "addAbove": await Data.InsertAboveAsync(id, _selectedCell!.Weight ?? 0); break;
            case "addBelow": await Data.InsertBelowAsync(id, _selectedCell!.Weight ?? 0); break;
            case "delete":   await Data.DeleteAsync(id); break;
            case "logs": await SaveReturnTicketAsync(); Nav.NavigateTo("/logs?from=mon"); return;
        }

        await LoadPage(_pageIndex);
    }

    Task OnActionFromDetails(string action) => OnActionFromGrid(action);
}
