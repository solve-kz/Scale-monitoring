@page "/"
@using Microsoft.AspNetCore.Components.Authorization
@using Microsoft.JSInterop
@using Radzen
@using Scalemon.WebApp.Components.Auth
@inject IJSRuntime JS
@inject NotificationService Notification
@inject NavigationManager Nav

<AuthorizeView>
    <Authorized>
        <RadzenStack AlignItems="AlignItems.Center"
                     JustifyContent="JustifyContent.Center"
                     Orientation="Orientation.Vertical"
                     class="main-welcome">
            <RadzenImage Path="_content/Scalemon.WebApp/images/logo.png"
                         Style="width: 15rem;"
                         AlternateText="ScaleMonitoring" />
            <RadzenText TextStyle="TextStyle.DisplayH4">Добро пожаловать!</RadzenText>
            <RadzenText TextStyle="TextStyle.Subtitle1" Class="rz-text-secondary" TextAlign="TextAlign.Center">
                Вы успешно вошли в систему мониторинга. Выберите раздел в меню слева, чтобы продолжить работу.
            </RadzenText>
        </RadzenStack>
    </Authorized>
    <NotAuthorized>
        <RadzenCard class="main-login-card">
            <div class="main-login-layout">
                <div class="main-login-illustration">
                    <RadzenImage Path="_content/Scalemon.WebApp/wwwroot/images/logo.png"
                                 AlternateText="ScaleMonitoring"
                                 Style="max-width: 100%; height: auto;" />
                </div>
                <div class="main-login-form">
                    <RadzenText TextStyle="TextStyle.H5">Вход в систему</RadzenText>
                    <RadzenText TextStyle="TextStyle.Body2" Class="rz-text-secondary">
                        Используйте учетную запись для доступа к данным мониторинга.
                    </RadzenText>
                    @if (!string.IsNullOrEmpty(_errorMessage))
                    {
                        <RadzenAlert Severity="AlertSeverity.Error" Closeable="true" Close="ClearError">
                            @_errorMessage
                        </RadzenAlert>
                    }
                    <RadzenTemplateForm TItem="LoginVm"
                                        Data="@_model"
                                        Submit="OnSubmitAsync">
                        <RadzenStack Orientation="Orientation.Vertical" Gap="16px">
                            <RadzenFormField Text="Логин" Component="Login">
                                <RadzenTextBox @bind-Value="_model.Login"
                                               Name="Login"
                                               Placeholder="Введите логин"
                                               Style="width:100%;" />
                                <RadzenRequiredValidator Component="Login" Text="Укажите логин" />
                            </RadzenFormField>
                            <RadzenFormField Text="Пароль" Component="Password">
                                <RadzenPassword @bind-Value="_model.Pass"
                                                Name="Password"
                                                Placeholder="Введите пароль"
                                                Style="width:100%;" />
                                <RadzenRequiredValidator Component="Password" Text="Введите пароль" />
                            </RadzenFormField>
                            <RadzenValidationSummary />
                            <RadzenButton ButtonStyle="ButtonStyle.Primary"
                                          ButtonType="ButtonType.Submit"
                                          Icon="login"
                                          Text="Войти"
                                          IsBusy="@_isBusy"
                                          Disabled="@_isBusy"
                                          Style="width:100%;" />
                        </RadzenStack>
                    </RadzenTemplateForm>
                </div>
            </div>
        </RadzenCard>
    </NotAuthorized>
</AuthorizeView>

@code {
    private LoginVm _model = new();
    private bool _isBusy;
    private string? _errorMessage;

    private async Task OnSubmitAsync(LoginVm model)
    {
        if (_isBusy)
        {
            return;
        }

        _isBusy = true;
        _errorMessage = null;

        try
        {
            var ok = await JS.InvokeAsync<bool>("scalemon.login", model.Login, model.Pass);
            if (ok)
            {
                Notification.Notify(NotificationSeverity.Success, "Добро пожаловать", "Вы успешно вошли в систему.");
                Nav.NavigateTo("/", true);
                return;
            }

            _errorMessage = "Неверный логин или пароль.";
            Notification.Notify(NotificationSeverity.Error, "Ошибка входа", _errorMessage);
        }
        catch (JSException)
        {
            _errorMessage = "Не удалось выполнить вход. Повторите попытку позже.";
            Notification.Notify(NotificationSeverity.Error, "Ошибка", _errorMessage);
        }
        finally
        {
            _model.Pass = string.Empty;
            _isBusy = false;
            await InvokeAsync(StateHasChanged);
        }
    }

    private void ClearError()
    {
        _errorMessage = null;
    }
}
