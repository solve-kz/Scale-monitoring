        }
    }

    async Task TestPlc()
    {
        try
        {
            await Api.PingPlcAsync(_cts?.Token ?? default);
            NotificationService.Notify(NotificationSeverity.Success, "PLC", "Пинг отправлен");
        }
        catch (Exception ex)
        {
            NotificationService.Notify(NotificationSeverity.Error, "PLC", ex.Message);
        }
    }

   

