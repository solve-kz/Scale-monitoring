    private async Task LoadLogPreviewAsync()
    {
        var path = string.IsNullOrWhiteSpace(SelectedLogPath)
            ? LogPaths?.MainLogPath
            : SelectedLogPath;

        LogPreview = (await Api.GetLogPreviewAsync(path, _cts?.Token ?? default)).ToList();
    }

    private async Task OnLogPathChangedAsync(ChangeEventArgs e)
    {
        SelectedLogPath = e.Value?.ToString();
        await LoadLogPreviewAsync();
    }

