@page "/"
@addTagHelper *, Microsoft.AspNetCore.Mvc.TagHelpers
@using Scalemon.WebApp
@using Scalemon.WebApp.Components

@{
    Layout = null;
}
<!DOCTYPE html>
<html lang="ru">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <base href="~/" />
    <title>ScaleMonitoring</title>
    <link rel="icon" type="image/png" href="~/favicon.png" />
    <link href="~/app.css" rel="stylesheet" asp-append-version="true" />
</head>
<body>
    <app>
        <component type="typeof(App)" />
    </app>

    <!-- .NET 8 -->
    <script src="_framework/blazor.web.js"></script>

    <!-- Radzen -->
    <script src="_content/Radzen.Blazor/Radzen.Blazor.js" asp-append-version="true"></script>

    <!-- Твои скрипты (в корне wwwroot) -->
    <script src="~/auth.js" asp-append-version="true"></script>
    <script src="~/App.js" asp-append-version="true"></script>
</body>
</html>
