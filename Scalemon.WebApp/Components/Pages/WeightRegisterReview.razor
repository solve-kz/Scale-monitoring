    private bool CanMoveQueueItem(WeightRegisterRecognitionQueueItem item, int direction)
    {
        if (item.Status != RegisterRecognitionStatus.Pending || _recognitionQueueInfo is null)
        {
            return false;
        }
        var pending = _recognitionQueueInfo.Items
            .Where(candidate => candidate.Status == RegisterRecognitionStatus.Pending)
            .ToArray();
        var index = Array.FindIndex(pending, candidate => candidate.ProjectId == item.ProjectId);
        return index >= 0 && index + direction >= 0 && index + direction < pending.Length;
    }

