    private async Task OnAppendUploadComplete(UploadCompleteEventArgs _)
    {
        if (_project is null)
        {
            return;
        }
        var projectId = _project.Id;
        var existingSheetIds = _project.Sheets.Select(sheet => sheet.Id).ToHashSet(StringComparer.Ordinal);
        await LoadProjectAsync(projectId);
        var addedSheet = _project?.Sheets.FirstOrDefault(sheet => !existingSheetIds.Contains(sheet.Id));
        if (addedSheet is not null)
        {
            _selectedSheetId = addedSheet.Id;
            SelectSheet();
        }
        await LoadProjectsAsync(selectNewest: false);
        NotificationService.Notify(
            NotificationSeverity.Success,
            "Листы добавлены",
            "Новые листы добавлены в проект текущего дня. Проверьте их калибровку.");
    }

