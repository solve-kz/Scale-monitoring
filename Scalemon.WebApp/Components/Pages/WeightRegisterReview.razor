    private string RecognitionTimingText
    {
        get
        {
            if (_project is null)
            {
                return string.Empty;
            }

            var since = _project.RecognitionStatus == RegisterRecognitionStatus.Processing
                ? _project.RecognitionStartedAt
                : _project.RecognitionQueuedAt;
            var elapsed = since.HasValue ? FormatDuration(_recognitionClock - since.Value) : "неизвестно";
            var worker = _recognitionQueueInfo?.WorkerLastSeenAt is { } lastSeen
                ? $" Последний отклик исполнителя: {lastSeen.ToLocalTime():HH:mm:ss}."
                : " Отклик исполнителя ещё не получен.";
            var workerMessage = string.IsNullOrWhiteSpace(_recognitionQueueInfo?.WorkerMessage)
                ? string.Empty
                : $" {_recognitionQueueInfo.WorkerMessage}";
            return $"Прошло: {elapsed}.{worker}{workerMessage}";
        }
    }

    private string? RecognitionQueueWarning
    {
        get
        {
            if (_project?.RecognitionStatus != RegisterRecognitionStatus.Pending || _recognitionQueueInfo is null)
            {
                return null;
            }
            if (!_recognitionQueueInfo.AutomaticRecognitionEnabled)
            {
                return "Автоматический исполнитель выключен в конфигурации запущенной службы.";
            }
            var workerSilent = _recognitionQueueInfo.WorkerLastSeenAt is not { } workerLastSeenAt
                || _recognitionClock - workerLastSeenAt > TimeSpan.FromSeconds(90);
            if (_recognitionQueueInfo.ProcessingCount == 0 && workerSilent)
            {
                return "Фоновый исполнитель не подтверждает работу. Проверьте журнал службы и перезапустите именно Scalemon.ServiceHost.";
            }
            return null;
        }
    }

