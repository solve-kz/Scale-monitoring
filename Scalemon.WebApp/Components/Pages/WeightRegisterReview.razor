    private string F(double value) => value.ToString("0.###", _invariant);

    private static string FormatDuration(TimeSpan duration)
    {
        if (duration < TimeSpan.Zero)
        {
            duration = TimeSpan.Zero;
        }
        return duration.TotalHours >= 1
            ? $"{(int)duration.TotalHours}:{duration.Minutes:00}:{duration.Seconds:00}"
            : $"{duration.Minutes}:{duration.Seconds:00}";
    }

    private async Task RefreshRecognitionStatusAsync(CancellationToken cancellationToken)
    {
        try
        {
            while (!cancellationToken.IsCancellationRequested)
            {
                await Task.Delay(TimeSpan.FromSeconds(3), cancellationToken);
                var projectId = _project?.Id;
                var previousStatus = _project?.RecognitionStatus;
                var hasActiveQueue = _recognitionQueueInfo?.Items.Count > 0;
                var refreshCurrentDay = _project?.CuttingDate == Today && HasRecognizedSheets;
                if (string.IsNullOrWhiteSpace(projectId)
                    || (previousStatus is not (RegisterRecognitionStatus.Pending or RegisterRecognitionStatus.Processing)
                        && !hasActiveQueue
                        && !refreshCurrentDay))
                {
                    continue;
                }

                var latest = await ReviewService.GetProjectAsync(projectId, cancellationToken);
                if (latest is null)
                {
                    continue;
                }
                var queueInfo = await ReviewService.GetRecognitionQueueInfoAsync(projectId, cancellationToken);
                var statusChanged = latest.RecognitionStatus != previousStatus;

                await InvokeAsync(async () =>
                {
                    if (_project?.Id != projectId)
                    {
                        return;
                    }

                    if (statusChanged
                        && latest.RecognitionStatus is RegisterRecognitionStatus.Completed or RegisterRecognitionStatus.Failed)
                    {
                        await LoadProjectAsync(projectId);
                    }
                    else
                    {
                        ApplyRecognitionState(latest);
                    }
                    _recognitionQueueInfo = queueInfo;
                    _recognitionClock = DateTimeOffset.Now;
                    if (refreshCurrentDay
                        && _recognitionClock - _lastAutomaticRefreshAt >= TimeSpan.FromSeconds(9))
                    {
                        var selectedKey = _selectedComparison?.Key;
                        await RebuildComparisonAsync();
                        BuildGridRows();
                        if (selectedKey is { } key && _comparison.Cells.TryGetValue(key, out var refreshed))
                        {
                            OnCellSelected(refreshed);
                        }
                        _lastAutomaticRefreshAt = _recognitionClock;
                    }
                    if (statusChanged)
                    {
                        _projects = await ReviewService.ListProjectsAsync(cancellationToken);
                    }
                    if (statusChanged && latest.RecognitionStatus == RegisterRecognitionStatus.Completed)
                    {
                        NotificationService.Notify(
                            NotificationSeverity.Success,
                            "Распознавание",
                            "Сканы распознаны и сопоставлены с автоматическим реестром.");
                    }
                    else if (statusChanged && latest.RecognitionStatus == RegisterRecognitionStatus.Failed)
                    {
                        NotificationService.Notify(
                            NotificationSeverity.Error,
                            "Распознавание",
                            latest.StatusMessage ?? "Распознавание завершилось с ошибкой.");
                    }
                    StateHasChanged();
                });
            }
        }
        catch (OperationCanceledException) when (cancellationToken.IsCancellationRequested)
        {
        }
        catch (Exception ex)
        {
            await InvokeAsync(() => NotificationService.Notify(
                NotificationSeverity.Warning,
                "Распознавание",
                $"Не удалось обновить статус автоматически: {ex.Message}"));
        }
    }

    private void ApplyRecognitionState(WeightRegisterProject latest)
    {
        if (_project?.Id != latest.Id)
        {
            return;
        }

        _project.RecognitionStatus = latest.RecognitionStatus;
        _project.StatusMessage = latest.StatusMessage;
        _project.RecognitionAttempt = latest.RecognitionAttempt;
        _project.RecognitionQueuedAt = latest.RecognitionQueuedAt;
        _project.RecognitionStartedAt = latest.RecognitionStartedAt;
        _project.RecognitionFinishedAt = latest.RecognitionFinishedAt;
        _project.RecognitionUpdatedAt = latest.RecognitionUpdatedAt;
        _project.RecognitionCompletedSheets = latest.RecognitionCompletedSheets;
        _project.RecognitionTotalSheets = latest.RecognitionTotalSheets;
        _project.RecognitionCurrentSheet = latest.RecognitionCurrentSheet;
    }

    /// <inheritdoc />
    public async ValueTask DisposeAsync()
    {
        _refreshCts.Cancel();
        if (_refreshTask is not null)
        {
            await _refreshTask;
        }
        _refreshCts.Dispose();
    }

    private enum CalibrationEdge
    {
        Left,
        Top,
        Right,
        Bottom
    }
}
