        => _project is null
            ? string.Empty
            : _project.CuttingDate.ToString("dd.MM.yyyy");

    private void SelectSheet()
    {
        _selectedSheet = _project?.Sheets.FirstOrDefault(sheet => sheet.Id == _selectedSheetId);
        _calibration = _selectedSheet?.Calibration?.Copy();
        _selectedComparison = null;
        _cellBounds = null;
        _editedValue = null;
        ResetCalibrationSliders();
        BuildGridRows();
    }

    private void BuildGridRows()
    {
        if (_selectedSheet is null)
        {
            _rows = Array.Empty<RegisterGridRowVm>();
            _totals = new Dictionary<int, decimal>();
            _recognizedTotals = new Dictionary<int, RegisterReviewTotal>();
            return;
        }

        var rows = new List<RegisterGridRowVm>(_selectedSheet.Table.DataRows);
        for (var row = 1; row <= _selectedSheet.Table.DataRows; row++)
        {
            var cells = new Dictionary<int, RegisterCellComparison?>();
            for (var column = 1; column <= _selectedSheet.Table.Columns; column++)
            {
                _comparison.Cells.TryGetValue(new RegisterCellKey(_selectedSheet.Id, row, column), out var comparison);
                cells[column] = comparison;
            }
            rows.Add(new RegisterGridRowVm(row, cells));
        }
        _rows = rows;
        _totals = _selectedSheet.Cells
            .Where(cell => cell.EffectiveValue.HasValue)
            .GroupBy(cell => cell.Column)
            .ToDictionary(group => group.Key, group => group.Sum(cell => cell.EffectiveValue!.Value));
        _recognizedTotals = _selectedSheet.Totals
            .Where(total => total.Column >= 1 && total.Column <= _selectedSheet.Table.Columns)
            .Where(total => total.EffectiveValue.HasValue)
            .GroupBy(total => total.Column)
            .ToDictionary(
                group => group.Key,
                group => group.OrderBy(total => total.Row).First());
    }

