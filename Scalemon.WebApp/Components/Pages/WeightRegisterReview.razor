    private void OnTotalSelected(int column)
    {
        if (_selectedSheet is null
            || column < 1
            || column > _selectedSheet.Table.Columns
            || _selectedSheet.Table.TotalRows < 1)
        {
            return;
        }

        _selectedComparison = null;
        _selectedTotalColumn = column;
        _selectedTotal = _recognizedTotals.TryGetValue(column, out var total)
            ? total
            : new RegisterReviewTotal
            {
                Row = 1,
                Column = column,
                Status = RegisterCellStatus.Empty
            };
        _editedValue = _selectedTotal.EffectiveValue;
        _cellBounds = WeightRegisterGeometry.GetTotalBounds(_selectedSheet, totalRow: 1, column: column);
    }

