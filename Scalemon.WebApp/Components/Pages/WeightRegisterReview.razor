    private void OnCalibrationSliderChanged(CalibrationEdge edge, double value)
    {
        var previous = edge switch
        {
            CalibrationEdge.Left => _leftCalibrationSlider,
            CalibrationEdge.Top => _topCalibrationSlider,
            CalibrationEdge.Right => _rightCalibrationSlider,
            CalibrationEdge.Bottom => _bottomCalibrationSlider,
            _ => 0d
        };
        switch (edge)
        {
            case CalibrationEdge.Left:
                _leftCalibrationSlider = value;
                break;
            case CalibrationEdge.Top:
                _topCalibrationSlider = value;
                break;
            case CalibrationEdge.Right:
                _rightCalibrationSlider = value;
                break;
            case CalibrationEdge.Bottom:
                _bottomCalibrationSlider = value;
                break;
        }
        NudgeCalibration(edge, value - previous);
    }

    private void NudgeCalibration(CalibrationEdge edge, double direction)
    {
        if (_calibration is null || Math.Abs(direction) < 0.001d)
        {
            return;
        }

        var delta = direction * CalibrationBoundaryStep;
        var minimumWidth = Math.Min(20d, _calibration.ImageWidth);
        var minimumHeight = Math.Min(20d, _calibration.ImageHeight);
        switch (edge)
        {
            case CalibrationEdge.Left:
                _calibration.TableLeft = Math.Clamp(
                    _calibration.TableLeft + delta,
                    0d,
                    Math.Max(0d, _calibration.TableRight - minimumWidth));
                break;
            case CalibrationEdge.Top:
                _calibration.TableTop = Math.Clamp(
                    _calibration.TableTop + delta,
                    0d,
                    Math.Max(0d, _calibration.TableBottom - minimumHeight));
                break;
            case CalibrationEdge.Right:
                _calibration.TableRight = Math.Clamp(
                    _calibration.TableRight + delta,
                    Math.Min(_calibration.ImageWidth, _calibration.TableLeft + minimumWidth),
                    _calibration.ImageWidth);
                break;
            case CalibrationEdge.Bottom:
                _calibration.TableBottom = Math.Clamp(
                    _calibration.TableBottom + delta,
                    Math.Min(_calibration.ImageHeight, _calibration.TableTop + minimumHeight),
                    _calibration.ImageHeight);
                break;
        }
    }

    private void OnRotationSliderChanged(double value)
    {
        var delta = value - _rotationCalibrationSlider;
        _rotationCalibrationSlider = value;
        NudgeRotation(delta);
    }

    private void NudgeRotation(double delta)
    {
        if (_calibration is null || Math.Abs(delta) < 0.001d)
        {
            return;
        }

        _calibration.RotationDegrees = Math.Clamp(_calibration.RotationDegrees + delta, -5d, 5d);
    }

    private void ResetCalibrationSliders()
    {
        _leftCalibrationSlider = 0d;
        _topCalibrationSlider = 0d;
        _rightCalibrationSlider = 0d;
        _bottomCalibrationSlider = 0d;
        _rotationCalibrationSlider = 0d;
    }

    private void ResetCalibration()
    {
        if (_selectedSheet?.Calibration is null)
        {
            return;
        }

        _calibration = WeightRegisterGeometry.CreateDefaultCalibration(
            _selectedSheet.Calibration.ImageWidth,
            _selectedSheet.Calibration.ImageHeight);
        ResetCalibrationSliders();
    }

