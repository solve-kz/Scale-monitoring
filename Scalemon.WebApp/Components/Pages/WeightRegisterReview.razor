@page "/weight-register-review"
@attribute [Authorize]
@implements IAsyncDisposable
@using System.Globalization
@using Microsoft.AspNetCore.WebUtilities
@using Scalemon.WebApp.Components.Dialogs
@using Scalemon.WebApp.Models
@inject IWeightRegisterReviewService ReviewService
@inject IWeighingDataService WeighingData
@inject WeightRegisterComparisonEngine ComparisonEngine
@inject NavigationManager Navigation
@inject NotificationService NotificationService
@inject DialogService DialogService
@inject IJSRuntime JS

<RadzenStack Orientation="Orientation.Vertical" Gap="1rem">
    <RadzenCard>
        <RadzenStack Orientation="Orientation.Vertical" Gap="0.75rem">
            <RadzenText TextStyle="TextStyle.H5">Сверка ручного реестра</RadzenText>
            <RadzenRow AlignItems="AlignItems.End" Gap="1rem">
                @if (CanSee(2))
                {
                    <RadzenColumn Size="12" SizeMD="3">
                        <RadzenLabel Text="Дата разделки" />
                        <RadzenDatePicker TValue="DateTime"
                                          @bind-Value="_uploadDate"
                                          DateFormat="dd.MM.yyyy"
                                          Style="width:100%" />
                    </RadzenColumn>
                    <RadzenColumn Size="12" SizeMD="3">
                        <RadzenUpload Url="@UploadUrl"
                                      ParameterName="files"
                                      Multiple="true"
                                      Auto="true"
                                      Accept=".jpg,.jpeg,.png"
                                      ChooseText="Загрузить"
                                      Complete="OnUploadComplete"
                                      Error="OnUploadError"
                                      Style="width:100%" />
                    </RadzenColumn>
                }
                <RadzenColumn Size="12" SizeMD="6">
                    <RadzenLabel Text="Сохранённый проект" />
                    <RadzenDropDown TValue="string"
                                    Data="_projects"
                                    TextProperty="DisplayName"
                                    ValueProperty="Id"
                                    Value="_selectedProjectId"
                                    Change="OnProjectChanged"
                                    AllowClear="true"
                                    Placeholder="Выберите дату и проект"
                                    Style="width:100%" />
                </RadzenColumn>
            </RadzenRow>
        </RadzenStack>
    </RadzenCard>

    @if (_project is null)
    {
        <RadzenAlert AlertStyle="AlertStyle.Info" Variant="Variant.Flat">
            Загрузите JPG/PNG-сканы одной даты или выберите сохранённый проект.
        </RadzenAlert>
    }
    else
    {
        <RadzenCard>
            <RadzenStack Orientation="Orientation.Horizontal"
                         AlignItems="AlignItems.Center"
                         JustifyContent="JustifyContent.SpaceBetween"
                         Gap="1rem"
                         Wrap="FlexWrap.Wrap">
                <RadzenStack Orientation="Orientation.Horizontal" AlignItems="AlignItems.Center" Gap="0.75rem">
                    <RadzenText TextStyle="TextStyle.H6">@_project.ProjectName</RadzenText>
                    <RadzenBadge Text="@RecognitionStatusText" BadgeStyle="@RecognitionBadgeStyle" />
                </RadzenStack>
                @if (CanSee(2))
                {
                    <RadzenStack Orientation="Orientation.Horizontal" Gap="0.5rem" Wrap="FlexWrap.Wrap">
                        @if (CanAppendSheets)
                        {
                            <RadzenUpload Url="@AppendUploadUrl"
                                          ParameterName="files"
                                          Multiple="true"
                                          Auto="true"
                                          Accept=".jpg,.jpeg,.png"
                                          ChooseText="Добавить листы"
                                          Complete="OnAppendUploadComplete"
                                          Error="OnUploadError" />
                        }
                        <RadzenButton Text="Запустить распознавание"
                                      Icon="document_scanner"
                                      ButtonStyle="ButtonStyle.Primary"
                                      Disabled="@(_project.RecognitionStatus is RegisterRecognitionStatus.CalibrationRequired or RegisterRecognitionStatus.Pending or RegisterRecognitionStatus.Processing)"
                                      Click="QueueRecognitionAsync" />
                        @if (_project.RecognitionStatus is RegisterRecognitionStatus.Pending or RegisterRecognitionStatus.Processing or RegisterRecognitionStatus.Failed)
                        {
                            <RadzenButton Text="Скачать задание и сканы"
                                          Icon="file_download"
                                          ButtonStyle="ButtonStyle.Light"
                                          Click="DownloadRecognitionRequestAsync" />
                        }
                        <RadzenUpload Url="@RecognitionImportUrl"
                                      ParameterName="file"
                                      Auto="true"
                                      Disabled="@(_project.RecognitionStatus == RegisterRecognitionStatus.Processing)"
                                      Accept=".json,application/json"
                                      ChooseText="Импортировать результат"
                                      Complete="OnRecognitionImported"
                                      Error="OnUploadError" />
                    </RadzenStack>
                }
            </RadzenStack>
            @if (!string.IsNullOrWhiteSpace(_project.StatusMessage))
            {
                <RadzenText TextStyle="TextStyle.Caption">@_project.StatusMessage</RadzenText>
            }
            @if (RecognitionWarnings.Count > 0)
            {
                <RadzenAlert AlertStyle="AlertStyle.Warning" Variant="Variant.Flat">
                    @foreach (var warning in RecognitionWarnings)
                    {
                        <div>@warning</div>
                    }
                </RadzenAlert>
            }
            @if (IsRecognitionActive)
            {
                <RadzenStack Orientation="Orientation.Vertical" Gap="0.4rem" Style="margin-top:0.75rem;">
                    <RadzenProgressBar Mode="ProgressBarMode.Indeterminate" Style="width:100%;" />
                    <RadzenText TextStyle="TextStyle.Body2">@RecognitionActivityText</RadzenText>
                    <RadzenText TextStyle="TextStyle.Caption">@RecognitionTimingText</RadzenText>
                    @if (RecognitionQueueWarning is { } warning)
                    {
                        <RadzenAlert AlertStyle="AlertStyle.Warning" Variant="Variant.Flat">@warning</RadzenAlert>
                    }
                </RadzenStack>
            }
            else if (_project.RecognitionFinishedAt is { } finishedAt)
            {
                <RadzenText TextStyle="TextStyle.Caption">
                    Завершено @finishedAt.ToLocalTime().ToString("dd.MM.yyyy HH:mm:ss").
                </RadzenText>
            }
            @if (CanSee(2) && _recognitionQueueInfo?.Items.Count > 0)
            {
                <RadzenFieldset Text="Управление очередью" Style="margin-top:0.75rem;">
                    <RadzenStack Orientation="Orientation.Vertical" Gap="0.45rem">
                        @foreach (var item in _recognitionQueueInfo.Items)
                        {
                            <RadzenStack Orientation="Orientation.Horizontal"
                                         AlignItems="AlignItems.Center"
                                         JustifyContent="JustifyContent.SpaceBetween"
                                         Gap="0.5rem"
                                         Wrap="FlexWrap.Wrap">
                                <RadzenText TextStyle="TextStyle.Body2">
                                    @item.Position. @item.CuttingDate.ToString("dd.MM.yyyy") — @item.ProjectName
                                    (@QueueItemStatusText(item))
                                </RadzenText>
                                <RadzenStack Orientation="Orientation.Horizontal" Gap="0.25rem">
                                    <RadzenButton Icon="arrow_upward"
                                                  Size="ButtonSize.Small"
                                                  ButtonStyle="ButtonStyle.Light"
                                                  Disabled="@(!CanMoveQueueItem(item, -1))"
                                                  Click="@(() => MoveQueueItemAsync(item.ProjectId, -1))" />
                                    <RadzenButton Icon="arrow_downward"
                                                  Size="ButtonSize.Small"
                                                  ButtonStyle="ButtonStyle.Light"
                                                  Disabled="@(!CanMoveQueueItem(item, 1))"
                                                  Click="@(() => MoveQueueItemAsync(item.ProjectId, 1))" />
                                    <RadzenButton Icon="cancel"
                                                  Size="ButtonSize.Small"
                                                  ButtonStyle="ButtonStyle.Danger"
                                                  Disabled="@item.CancellationRequested"
                                                  Click="@(() => CancelQueueItemAsync(item))" />
                                </RadzenStack>
                            </RadzenStack>
                        }
                    </RadzenStack>
                </RadzenFieldset>
            }
        </RadzenCard>

        <RadzenRow Gap="1rem">
            <RadzenColumn Order="1" Size="12" SizeLG="8" SizeXL="9" Style="min-width:0;">
                <RadzenCard>
                    <RadzenStack Orientation="Orientation.Vertical" Gap="1rem">
                        <RadzenStack Orientation="Orientation.Horizontal"
                                     AlignItems="AlignItems.End"
                                     JustifyContent="JustifyContent.SpaceBetween"
                                     Wrap="FlexWrap.Wrap"
                                     Gap="1rem">
                            <div style="min-width:260px;">
                                <RadzenLabel Text="Лист" />
                                <RadzenDropDown TValue="string"
                                                Data="_project.Sheets"
                                                TextProperty="DisplayName"
                                                ValueProperty="Id"
                                                Value="_selectedSheetId"
                                                Change="OnSheetChanged"
                                                Style="width:100%" />
                            </div>
                            <RadzenStack Orientation="Orientation.Horizontal" Gap="0.75rem" Wrap="FlexWrap.Wrap">
                                @LegendItem("#f4cccc", "нет в автоматической записи")
                                @LegendItem("#d9ead3", "разница ≤ 0,04 кг")
                                @LegendItem("#f8d7da", "разница > 0,04 кг")
                                @LegendItem("#fce5cd", "пропуск в ручной записи")
                            </RadzenStack>
                        </RadzenStack>

                        <RadzenStack Orientation="Orientation.Horizontal" AlignItems="AlignItems.Center" Gap="0.75rem">
                            <RadzenText TextStyle="TextStyle.Subtitle2">
                                @(_includeSanitary ? "Санитарный включён в сравнение" : "Санитарный исключён из сравнения")
                            </RadzenText>
                            <RadzenSwitch @bind-Value="_includeSanitary" @bind-Value:after="OnSanitaryToggleChangedAsync" />
                            @if (HasRecognizedSheets)
                            {
                                <RadzenText TextStyle="TextStyle.Caption">
                                    Автоматические записи: @AutomaticDatesText@(_project.CuttingDate == Today ? "; обновляются автоматически" : string.Empty)
                                </RadzenText>
                            }
                        </RadzenStack>

                        @if (_selectedSheet?.IsRecognitionComplete == true)
                        {
                            @if (!string.IsNullOrWhiteSpace(_comparisonError))
                            {
                                <RadzenAlert AlertStyle="AlertStyle.Danger" Variant="Variant.Flat">@_comparisonError</RadzenAlert>
                            }
                            else
                            {
                                <RegisterComparisonGrid Rows="_rows"
                                                        Totals="_totals"
                                                        RecognizedTotals="_recognizedTotals"
                                                        SelectedKey="_selectedComparison?.Key"
                                                        SelectedTotalColumn="_selectedTotalColumn"
                                                        CellSelected="OnCellSelected"
                                                        CellDoubleClicked="OnCellDoubleClicked"
                                                        TotalSelected="OnTotalSelected" />
                                <RadzenText TextStyle="TextStyle.Caption">
                                    Ручных записей без пары: @_comparison.ManualOnlyCount; автоматических записей без ручной пары: @_comparison.AutomaticOnlyCount.
                                    Янтарная внутренняя рамка означает статус Suspect.
                                </RadzenText>
                            }
                        }
                        else
                        {
                            <RadzenAlert AlertStyle="AlertStyle.Info" Variant="Variant.Flat">
                                Этот лист ещё не распознан. Сохраните его калибровку и запустите распознавание; уже готовые листы остаются доступными в списке.
                            </RadzenAlert>
                        }
                    </RadzenStack>
                </RadzenCard>
            </RadzenColumn>

            <RadzenColumn Order="2" Size="12" SizeLG="4" SizeXL="3" Style="min-width:0;">
                <RadzenStack Orientation="Orientation.Vertical" Gap="1rem" Style="height:100%;">
                    @if ((_selectedComparison is not null || _selectedTotal is not null) && _selectedSheet is not null)
                    {
                        <RadzenCard class="weight-register-cell-inspector">
                            <RadzenStack Orientation="Orientation.Vertical" Gap="0.75rem">
                                <RadzenText TextStyle="TextStyle.H6">@SelectedCellTitle</RadzenText>
                                @if (_cellBounds is not null && _selectedSheet.Calibration is not null)
                                {
                                    <svg viewBox="@CellCropViewBox"
                                         preserveAspectRatio="xMidYMid meet"
                                         style="width:100%;height:190px;background:#fff;border:1px solid var(--rz-border-color);">
                                        <image href="@ImageUrl"
                                               width="@_selectedSheet.Calibration.ImageWidth"
                                               height="@_selectedSheet.Calibration.ImageHeight"
                                               transform="@ImageRotationTransform" />
                                        <rect x="@F(_cellBounds.Left)"
                                              y="@F(_cellBounds.Top)"
                                              width="@F(_cellBounds.Width)"
                                              height="@F(_cellBounds.Height)"
                                              fill="none"
                                              stroke="#2563eb"
                                              stroke-width="1" />
                                    </svg>
                                }

                                @if (_selectedComparison is not null)
                                {
                                    <RadzenText TextStyle="TextStyle.Body2">
                                        Автоматическая запись:
                                        @if (_selectedComparison.Automatic is not null)
                                        {
                                            <b>@_selectedComparison.Automatic.Weight.ToString("0.00") кг, @_selectedComparison.Automatic.Timestamp.ToString("HH:mm:ss")</b>
                                        }
                                        else
                                        {
                                            <b>отсутствует</b>
                                        }
                                    </RadzenText>
                                    @if (_selectedComparison.AutomaticGaps.Count > 0)
                                    {
                                        <RadzenAlert AlertStyle="AlertStyle.Warning" Variant="Variant.Flat">
                                            Между соседними ручными ячейками есть автоматическая запись:
                                            @string.Join(", ", _selectedComparison.AutomaticGaps.Select(item => $"{item.Weight:0.00} кг {item.Timestamp:HH:mm:ss}"))
                                        </RadzenAlert>
                                    }
                                    @if (!string.IsNullOrWhiteSpace(_selectedComparison.Manual.Comment))
                                    {
                                        <RadzenText TextStyle="TextStyle.Caption">@_selectedComparison.Manual.Comment</RadzenText>
                                    }
                                }
                                else if (_selectedTotal is not null)
                                {
                                    <RadzenText TextStyle="TextStyle.Body2">
                                        Сумма распознанных строк 1–40:
                                        <b>@(SelectedCalculatedTotal?.ToString("0.00") ?? "отсутствует") кг</b>
                                    </RadzenText>
                                    <RadzenText TextStyle="TextStyle.Body2">
                                        Отклонение итога:
                                        <b>@SelectedTotalDifferenceText</b>
                                    </RadzenText>
                                    @if (!string.IsNullOrWhiteSpace(_selectedTotal.Comment))
                                    {
                                        <RadzenText TextStyle="TextStyle.Caption">@_selectedTotal.Comment</RadzenText>
                                    }
                                }
                                @if (CanSee(2))
                                {
                                    <RadzenLabel Text="@SelectedEditorLabel" />
                                    <RadzenNumeric TValue="decimal?"
                                                   @bind-Value="_editedValue"
                                                   Min="@(0.02m)"
                                                   Max="@SelectedEditorMaximum"
                                                   Step="0.02"
                                                   Format="0.00"
                                                   Style="width:100%" />
                                    <RadzenButton Text="Записать"
                                                  Icon="save"
                                                  ButtonStyle="ButtonStyle.Primary"
                                                  Click="SaveCorrectionAsync" />
                                }
                            </RadzenStack>
                        </RadzenCard>
                    }

                    @if (_selectedSheet is not null && _calibration is not null)
                    {
                        <RadzenCard>
                            <RadzenStack Orientation="Orientation.Vertical" Gap="0.75rem">
                                <RadzenStack Orientation="Orientation.Horizontal" JustifyContent="JustifyContent.SpaceBetween" AlignItems="AlignItems.Center">
                                    <RadzenText TextStyle="TextStyle.H6">Калибровка листа</RadzenText>
                                    <RadzenBadge Text="@(_selectedSheet.IsCalibrationConfirmed ? "сохранена" : "не подтверждена")"
                                                 BadgeStyle="@(_selectedSheet.IsCalibrationConfirmed ? BadgeStyle.Success : BadgeStyle.Warning)" />
                                </RadzenStack>
                                @if (CanSee(2))
                                {
                                    <div style="display:grid;grid-template-columns:48px minmax(0,1fr) 48px;grid-template-rows:auto minmax(320px,520px) auto;gap:0.5rem;align-items:center;">
                                        <RadzenStack Orientation="Orientation.Horizontal" AlignItems="AlignItems.Center" Gap="0.5rem"
                                                     Style="grid-column:2;grid-row:1;">
                                            <RadzenButton Text="−" Title="Верхняя граница вверх" ButtonStyle="ButtonStyle.Light"
                                                          Click="@(() => NudgeCalibration(CalibrationEdge.Top, -1d))" />
                                            <RadzenSlider TValue="double" Value="_topCalibrationSlider" Min="-60" Max="60" Step="1"
                                                          Change="@((double value) => OnCalibrationSliderChanged(CalibrationEdge.Top, value))"
                                                          Style="width:100%;" />
                                            <RadzenButton Text="+" Title="Верхняя граница вниз" ButtonStyle="ButtonStyle.Light"
                                                          Click="@(() => NudgeCalibration(CalibrationEdge.Top, 1d))" />
                                        </RadzenStack>

                                        <RadzenStack Orientation="Orientation.Vertical" AlignItems="AlignItems.Center" Gap="0.5rem"
                                                     Style="grid-column:1;grid-row:2;">
                                            <RadzenButton Text="+" Title="Левая граница вправо" ButtonStyle="ButtonStyle.Light"
                                                          Click="@(() => NudgeCalibration(CalibrationEdge.Left, 1d))" />
                                            <RadzenSlider TValue="double" Value="_leftCalibrationSlider" Min="-60" Max="60" Step="1"
                                                          Orientation="Orientation.Vertical"
                                                          Change="@((double value) => OnCalibrationSliderChanged(CalibrationEdge.Left, value))"
                                                          Style="height:220px;" />
                                            <RadzenButton Text="−" Title="Левая граница влево" ButtonStyle="ButtonStyle.Light"
                                                          Click="@(() => NudgeCalibration(CalibrationEdge.Left, -1d))" />
                                        </RadzenStack>

                                        <svg viewBox="@CalibrationViewBox"
                                             preserveAspectRatio="xMidYMid meet"
                                             style="grid-column:2;grid-row:2;width:100%;height:100%;max-height:520px;background:#fff;border:1px solid var(--rz-border-color);">
                                            <image href="@ImageUrl"
                                                   width="@_calibration.ImageWidth"
                                                   height="@_calibration.ImageHeight"
                                                   transform="@CalibrationRotationTransform" />
                                            <rect x="@F(_calibration.TableLeft)"
                                                  y="@F(_calibration.TableTop)"
                                                  width="@F(_calibration.TableRight - _calibration.TableLeft)"
                                                  height="@F(_calibration.TableBottom - _calibration.TableTop)"
                                                  fill="none"
                                                  stroke="#2563eb"
                                                  stroke-width="3" />
                                            @foreach (var line in CalibrationHorizontalLines)
                                            {
                                                <line x1="@F(_calibration.TableLeft)" y1="@F(line)"
                                                      x2="@F(_calibration.TableRight)" y2="@F(line)"
                                                      stroke="#2563eb" stroke-opacity="0.35" stroke-width="1" />
                                            }
                                            @foreach (var line in CalibrationVerticalLines)
                                            {
                                                <line x1="@F(line)" y1="@F(_calibration.TableTop)"
                                                      x2="@F(line)" y2="@F(_calibration.TableBottom)"
                                                      stroke="#2563eb" stroke-opacity="0.35" stroke-width="1" />
                                            }
                                        </svg>

                                        <RadzenStack Orientation="Orientation.Vertical" AlignItems="AlignItems.Center" Gap="0.5rem"
                                                     Style="grid-column:3;grid-row:2;">
                                            <RadzenButton Text="+" Title="Правая граница вправо" ButtonStyle="ButtonStyle.Light"
                                                          Click="@(() => NudgeCalibration(CalibrationEdge.Right, 1d))" />
                                            <RadzenSlider TValue="double" Value="_rightCalibrationSlider" Min="-60" Max="60" Step="1"
                                                          Orientation="Orientation.Vertical"
                                                          Change="@((double value) => OnCalibrationSliderChanged(CalibrationEdge.Right, value))"
                                                          Style="height:220px;" />
                                            <RadzenButton Text="−" Title="Правая граница влево" ButtonStyle="ButtonStyle.Light"
                                                          Click="@(() => NudgeCalibration(CalibrationEdge.Right, -1d))" />
                                        </RadzenStack>

                                        <RadzenStack Orientation="Orientation.Horizontal" AlignItems="AlignItems.Center" Gap="0.5rem"
                                                     Style="grid-column:2;grid-row:3;">
                                            <RadzenButton Text="−" Title="Нижняя граница вверх" ButtonStyle="ButtonStyle.Light"
                                                          Click="@(() => NudgeCalibration(CalibrationEdge.Bottom, -1d))" />
                                            <RadzenSlider TValue="double" Value="_bottomCalibrationSlider" Min="-60" Max="60" Step="1"
                                                          Change="@((double value) => OnCalibrationSliderChanged(CalibrationEdge.Bottom, value))"
                                                          Style="width:100%;" />
                                            <RadzenButton Text="+" Title="Нижняя граница вниз" ButtonStyle="ButtonStyle.Light"
                                                          Click="@(() => NudgeCalibration(CalibrationEdge.Bottom, 1d))" />
                                        </RadzenStack>
                                    </div>
                                }
                                else
                                {
                                    <svg viewBox="@CalibrationViewBox"
                                         preserveAspectRatio="xMidYMid meet"
                                         style="width:100%;max-height:520px;background:#fff;border:1px solid var(--rz-border-color);">
                                        <image href="@ImageUrl"
                                               width="@_calibration.ImageWidth"
                                               height="@_calibration.ImageHeight"
                                               transform="@CalibrationRotationTransform" />
                                        <rect x="@F(_calibration.TableLeft)"
                                              y="@F(_calibration.TableTop)"
                                              width="@F(_calibration.TableRight - _calibration.TableLeft)"
                                              height="@F(_calibration.TableBottom - _calibration.TableTop)"
                                              fill="none"
                                              stroke="#2563eb"
                                              stroke-width="3" />
                                        @foreach (var line in CalibrationHorizontalLines)
                                        {
                                            <line x1="@F(_calibration.TableLeft)" y1="@F(line)"
                                                  x2="@F(_calibration.TableRight)" y2="@F(line)"
                                                  stroke="#2563eb" stroke-opacity="0.35" stroke-width="1" />
                                        }
                                        @foreach (var line in CalibrationVerticalLines)
                                        {
                                            <line x1="@F(line)" y1="@F(_calibration.TableTop)"
                                                  x2="@F(line)" y2="@F(_calibration.TableBottom)"
                                                  stroke="#2563eb" stroke-opacity="0.35" stroke-width="1" />
                                        }
                                    </svg>
                                }
                                @if (CanSee(2))
                                {
                                    <RadzenStack Orientation="Orientation.Horizontal" AlignItems="AlignItems.Center" Gap="0.5rem">
                                        <RadzenButton Text="−" Title="Повернуть против часовой стрелки" ButtonStyle="ButtonStyle.Light"
                                                      Click="@(() => NudgeRotation(-0.1d))" />
                                        <RadzenSlider TValue="double" Value="_rotationCalibrationSlider" Min="-5" Max="5" Step="0.1"
                                                      Change="OnRotationSliderChanged"
                                                      Style="width:100%;" />
                                        <RadzenButton Text="+" Title="Повернуть по часовой стрелке" ButtonStyle="ButtonStyle.Light"
                                                      Click="@(() => NudgeRotation(0.1d))" />
                                    </RadzenStack>
                                    <RadzenText TextStyle="TextStyle.Caption" TextAlign="TextAlign.Center">
                                        Поворот: @_calibration.RotationDegrees.ToString("0.0", CultureInfo.InvariantCulture)°; шаг границ: 2 px
                                    </RadzenText>
                                    <RadzenRow Gap="0.5rem">
                                        <RadzenColumn Size="6"><RadzenLabel Text="Слева" /><RadzenNumeric TValue="double" @bind-Value="_calibration.TableLeft" Step="1" Style="width:100%" /></RadzenColumn>
                                        <RadzenColumn Size="6"><RadzenLabel Text="Справа" /><RadzenNumeric TValue="double" @bind-Value="_calibration.TableRight" Step="1" Style="width:100%" /></RadzenColumn>
                                        <RadzenColumn Size="6"><RadzenLabel Text="Сверху" /><RadzenNumeric TValue="double" @bind-Value="_calibration.TableTop" Step="1" Style="width:100%" /></RadzenColumn>
                                        <RadzenColumn Size="6"><RadzenLabel Text="Снизу" /><RadzenNumeric TValue="double" @bind-Value="_calibration.TableBottom" Step="1" Style="width:100%" /></RadzenColumn>
                                        <RadzenColumn Size="12"><RadzenLabel Text="Поворот, °" /><RadzenNumeric TValue="double" @bind-Value="_calibration.RotationDegrees" Min="-5" Max="5" Step="0.1" Style="width:100%" /></RadzenColumn>
                                    </RadzenRow>
                                    <RadzenStack Orientation="Orientation.Horizontal" Gap="0.5rem">
                                        <RadzenButton Text="Сбросить"
                                                      Icon="restart_alt"
                                                      ButtonStyle="ButtonStyle.Light"
                                                      Click="ResetCalibration" />
                                        <RadzenButton Text="Сохранить калибровку"
                                                      Icon="crop"
                                                      ButtonStyle="ButtonStyle.Secondary"
                                                      Click="SaveCalibrationAsync" />
                                    </RadzenStack>
                                }
                            </RadzenStack>
                        </RadzenCard>
                    }
                </RadzenStack>
            </RadzenColumn>
        </RadzenRow>
    }
</RadzenStack>

<style>
    .weight-register-cell-inspector {
        position: sticky;
        top: 1rem;
        z-index: 5;
        max-height: calc(100vh - 2rem);
        overflow-y: auto;
        align-self: stretch;
    }

    @@media (max-width: 991.98px) {
        .weight-register-cell-inspector {
            position: static;
            max-height: none;
            overflow-y: visible;
        }
    }
</style>

@code {
    private readonly CultureInfo _invariant = CultureInfo.InvariantCulture;
    private readonly CancellationTokenSource _refreshCts = new();
    private Task? _refreshTask;
    private WeightRegisterRecognitionQueueInfo? _recognitionQueueInfo;
    private DateTimeOffset _recognitionClock = DateTimeOffset.Now;
    private DateTimeOffset _lastAutomaticRefreshAt = DateTimeOffset.MinValue;
    private DateTime _uploadDate = DateTime.Today;
    private IReadOnlyList<WeightRegisterProjectSummary> _projects = Array.Empty<WeightRegisterProjectSummary>();
    private string? _selectedProjectId;
    private WeightRegisterProject? _project;
    private string? _selectedSheetId;
    private WeightRegisterSheet? _selectedSheet;
    private RegisterTableCalibration? _calibration;
    private RegisterComparisonResult _comparison = new();
    private IReadOnlyList<RegisterGridRowVm> _rows = Array.Empty<RegisterGridRowVm>();
    private IReadOnlyDictionary<int, decimal> _totals = new Dictionary<int, decimal>();
    private IReadOnlyDictionary<int, RegisterReviewTotal> _recognizedTotals = new Dictionary<int, RegisterReviewTotal>();
    private RegisterCellComparison? _selectedComparison;
    private RegisterReviewTotal? _selectedTotal;
    private int? _selectedTotalColumn;
    private RegisterCellBounds? _cellBounds;
    private decimal? _editedValue;
    private bool _includeSanitary = true;
    private string? _comparisonError;
    private double _leftCalibrationSlider;
    private double _topCalibrationSlider;
