    private async Task CancelQueueItemAsync(WeightRegisterRecognitionQueueItem item)
    {
        var actionText = item.Status == RegisterRecognitionStatus.Processing
            ? "запросить отмену выполняющегося задания"
            : "отменить ожидающее задание";
        var confirmed = await DialogService.Confirm(
            $"{actionText} «{item.ProjectName}»?",
            "Очередь распознавания",
            new ConfirmOptions { OkButtonText = "Да", CancelButtonText = "Нет" });
        if (confirmed != true)
        {
            return;
        }

        try
        {
            await ReviewService.CancelRecognitionAsync(item.ProjectId);
            _projects = await ReviewService.ListProjectsAsync();
            if (_project?.Id == item.ProjectId)
            {
                await LoadProjectAsync(item.ProjectId);
            }
            if (_project is not null)
            {
                _recognitionQueueInfo = await ReviewService.GetRecognitionQueueInfoAsync(_project.Id);
                _recognitionClock = DateTimeOffset.Now;
            }
            NotificationService.Notify(
                NotificationSeverity.Info,
                "Очередь распознавания",
                item.Status == RegisterRecognitionStatus.Processing
                    ? "Запрос отмены отправлен."
                    : "Задание отменено.");
        }
        catch (Exception ex)
        {
            NotificationService.Notify(NotificationSeverity.Error, "Очередь распознавания", ex.Message);
        }
    }

