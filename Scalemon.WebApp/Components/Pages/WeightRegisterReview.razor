    private async Task SaveCorrectionAsync()
    {
        if (_project is null || _selectedSheet is null) return;
        var projectId = _project.Id;
        try
        {
            if (_selectedComparison is not null)
            {
                var key = _selectedComparison.Key;
                await ReviewService.CorrectCellAsync(
                    projectId,
                    key.SheetId,
                    key.Row,
                    key.Column,
                    _editedValue,
                    CurrentUser?.Identity?.Name);
                await LoadProjectAsync(projectId);
                if (_comparison.Cells.TryGetValue(key, out var refreshed))
                {
                    OnCellSelected(refreshed);
                }
            }
            else if (_selectedTotalColumn is { } totalColumn)
            {
                var sheetId = _selectedSheet.Id;
                await ReviewService.CorrectTotalAsync(
                    projectId,
                    sheetId,
                    totalRow: 1,
                    column: totalColumn,
                    correctedValue: _editedValue,
                    editedBy: CurrentUser?.Identity?.Name);
                await LoadProjectAsync(projectId);
                OnTotalSelected(totalColumn);
            }
            else
            {
                return;
            }
            NotificationService.Notify(NotificationSeverity.Success, "Коррекция", "Значение записано.");
        }
        catch (Exception ex)
        {
            NotificationService.Notify(NotificationSeverity.Error, "Коррекция", ex.Message);
        }
    }

